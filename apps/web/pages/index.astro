---
import BlackjawLayout from '@/layouts/BlackjawLayout.astro';
import AnnouncementBar from '@/components/blackjaw/AnnouncementBar.astro';
import Header from '@/components/blackjaw/Header.astro';
import HeroSlideshow from '@/components/blackjaw/HeroSlideshow.astro';
import FeaturedCollections from '@/components/blackjaw/FeaturedCollections.astro';
import BrandMarquee from '@/components/blackjaw/BrandMarquee.astro';
import AboutStatement from '@/components/blackjaw/AboutStatement.astro';
import UgcGallery from '@/components/blackjaw/UgcGallery.astro';
import Footer from '@/components/blackjaw/Footer.astro';
---
<BlackjawLayout>
  <AnnouncementBar />
  <main>
    <div class="relative">
      <Header />
      <HeroSlideshow />
    </div>
    <FeaturedCollections />
    <BrandMarquee />
    <AboutStatement />
    <UgcGallery />
  </main>
  <Footer />
</BlackjawLayout>
