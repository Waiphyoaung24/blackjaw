---
import GhostCursor from "./GhostCursor.jsx";
---

<section class="bj-wordmark-band" aria-hidden="true">
  <div class="bj-wordmark-band__stage">
    <img
      class="bj-wordmark-band__mascot"
      src="/brand/blackjaw_runner.png"
      alt=""
      loading="lazy"
      decoding="async"
    />
    <img
      class="bj-wordmark-band__wordmark"
      src="/brand/blackjaw-wordmark-dark.png"
      alt=""
      loading="lazy"
      decoding="async"
    />
    <GhostCursor
      client:visible
      color="#f7bd02"
      mixBlendMode="screen"
      brightness={1.1}
      bloomStrength={0.15}
    />
  </div>
</section>

<style>
  .bj-wordmark-band {
    background-color: #282828;
    width: 100%;
  }

  .bj-wordmark-band__stage {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(16px, 3vw, 48px);
    height: clamp(160px, 22vw, 320px);
    max-width: 1440px;
    margin-inline: auto;
    padding-inline: clamp(16px, 4vw, 48px);
    overflow: hidden;
  }

  .bj-wordmark-band__mascot {
    flex: 0 0 auto;
    height: clamp(72px, 12vw, 180px);
    width: auto;
    object-fit: contain;
    user-select: none;
    pointer-events: none;
  }

  .bj-wordmark-band__wordmark {
    flex: 1 1 auto;
    height: auto;
    max-height: clamp(56px, 9vw, 140px);
    width: auto;
    max-width: 100%;
    object-fit: contain;
    user-select: none;
    pointer-events: none;
  }
</style>
