---
type Tile = {
  src: string;
  name: string;
  tag: string;
  handle: string;
  className: string; // grid placement
};

const tiles: Tile[] = [
  {
    src: "/brand/photo_2026-05-13%2003.01.45.jpeg",
    name: "Meegan",
    tag: "Lift",
    handle: "@meegan_lift",
    className: "sm:col-start-1 sm:row-span-3",
  },
  {
    src: "/brand/photo_2026-05-12%2016.55.14.jpeg",
    name: "Anaya",
    tag: "Run",
    handle: "@anaya_run",
    className: "sm:col-start-2 sm:row-span-1",
  },
  {
    src: "/brand/photo_2026-05-12%2016.55.19.jpeg",
    name: "Jonah",
    tag: "Climb",
    handle: "@jonah_climb",
    className: "sm:col-start-3 sm:row-span-1",
  },
  {
    src: "/brand/photo_2026-05-13%2002.58.07.jpeg",
    name: "Sol",
    tag: "Pilates",
    handle: "@sol_pilates",
    className: "sm:col-start-4 sm:row-span-3",
  },
  {
    src: "/brand/photo_2026-05-13%2002.58.14.jpeg",
    name: "Marc",
    tag: "Track",
    handle: "@marc_track",
    className: "sm:col-start-2 sm:row-span-2",
  },
  {
    src: "/brand/2026-05-13%2002.57.12.jpg",
    name: "Iris",
    tag: "Yoga",
    handle: "@iris_yoga",
    className: "sm:col-start-3 sm:row-span-2",
  },
];
---

<section class="bg-black text-white py-16 sm:py-20 lg:py-24">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-start justify-between gap-6 mb-8 sm:mb-12">
      <div>
        <div class="text-[10px] sm:text-[11px] tracking-[0.3em] text-white/40 uppercase mb-4 sm:mb-6">
           Work 26
        </div>
        <h2 class="font-[family-name:var(--font-primary)] font-black uppercase leading-[0.95] tracking-[-0.01em] text-[34px] sm:text-[56px] lg:text-[80px]">
          What Our Friends<br />Talk About BlackJaw.
        </h2>
      </div>
      <div class="hidden sm:block text-right shrink-0">
        <div class="text-[10px] tracking-[0.3em] text-white/40 uppercase mb-3">
          Tag to be featured
        </div>
        <div class="font-[family-name:var(--font-primary)] font-black uppercase text-[20px] lg:text-[28px] tracking-tight">
          #BlackJaw
        </div>
        <div class="text-[10px] tracking-[0.25em] text-white/30 uppercase mt-2">
          54,802 posts tagged
        </div>
      </div>
    </div>

    <div
      class="grid grid-cols-2 sm:grid-cols-4 sm:grid-rows-[repeat(3,clamp(110px,19vw,280px))] gap-2 sm:gap-3"
    >
      {
        tiles.map((t) => (
          <a
            href="#"
            class={`group relative block h-full w-full overflow-hidden rounded-[2px] bg-neutral-900 aspect-[4/5] sm:aspect-auto ${t.className}`}
          >
            <img
              src={t.src}
              alt={`${t.name} — ${t.tag}`}
              loading="lazy"
              class="absolute inset-0 w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-[1.02] transition-all duration-500 ease-out"
            />
            <div class="absolute inset-0 bg-gradient-to-b from-black/10 via-transparent to-black/60" />

            <span class="absolute top-2.5 right-2.5 sm:top-3 sm:right-3 inline-flex items-center gap-1.5 bg-black/70 backdrop-blur-sm text-white text-[9px] sm:text-[10px] tracking-[0.2em] uppercase px-2 py-1 rounded-[2px]">
              {t.name} <span class="text-white/40">/</span> {t.tag}
            </span>

            <span class="absolute bottom-2.5 left-2.5 sm:bottom-3 sm:left-3 text-white/85 text-[10px] sm:text-[11px] tracking-[0.15em] lowercase font-medium">
              {t.handle}
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
