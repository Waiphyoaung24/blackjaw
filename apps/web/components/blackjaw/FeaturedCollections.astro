---
import ProductCard from "./ProductCard.astro";
import { products } from "@/data/products";

const featureImg = encodeURI("/brand/photo_2026-05-12 16.55.07.jpeg");
const top = products.slice(0, 2);
const bottom = products.slice(2, 4);
---
<section id="featured" class="py-14 sm:py-20 lg:py-24 px-4 lg:px-8 max-w-[1440px] mx-auto">
  <div class="border-t border-bj-primary pt-6 mb-10 sm:mb-12 lg:mb-16 grid grid-cols-2 lg:grid-cols-4 gap-x-4 gap-y-6 lg:gap-10 text-[11px] tracking-[0.2em] uppercase">
    <div class="order-1">
      <div class="text-black/55 mb-2">Outfit</div>
      <div class="text-ink font-semibold">Featured</div>
    </div>
    <div class="order-3 col-span-2 lg:order-2 lg:col-span-2">
      <div class="text-black/55 mb-2">Why</div>
      <p class="normal-case tracking-normal text-[13px] text-ink/80 leading-relaxed max-w-[44ch]">
        Built by Blackjaw for athletes who bite through limits. Signature pieces engineered to never break — designed with care, made to outlast.
      </p>
    </div>
    <div class="order-2 text-right lg:order-3">
      <div class="text-black/55 mb-2">Visit · Shop</div>
      <a href="#" class="text-ink font-semibold hover:text-bj-primary transition-colors">Shipping & Returns</a>
    </div>
  </div>

  <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-4 gap-y-10 lg:gap-x-6 lg:gap-y-14">
    {top.map((p) => <ProductCard {...p} />)}

    <a
      href="#"
      class="group relative col-span-2 lg:row-span-2 overflow-hidden bg-ink aspect-[4/5]"
    >
      <img
        src={featureImg}
        alt="Signature Drop"
        class="absolute inset-0 w-full h-full object-cover opacity-90 transition-transform duration-[1200ms] ease-out group-hover:scale-105"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-br from-black/30 via-transparent to-black/30 pointer-events-none"></div>
      <div class="absolute top-5 left-5 text-white text-[10.5px] tracking-[0.24em] uppercase font-semibold flex items-center gap-2">
        <span class="inline-block w-[5px] h-[5px] rounded-full bg-bj-primary"></span>
        Signature Drop
      </div>
      <div class="absolute inset-0 flex items-center justify-center">
        <span class="flex items-center justify-center w-[88px] h-[88px] sm:w-[104px] sm:h-[104px] rounded-full bg-bj-primary text-ink text-[10px] sm:text-[11px] tracking-[0.2em] sm:tracking-[0.22em] uppercase font-bold shadow-[0_10px_28px_rgba(0,0,0,.28)] transition-transform duration-300 ease-out group-hover:scale-110">
          View More
        </span>
      </div>
    </a>

    {bottom.map((p) => <ProductCard {...p} />)}
  </div>

  <div class="flex justify-center mt-12 sm:mt-16">
    <a
      href="#"
      class="inline-flex items-center justify-center min-h-[48px] sm:min-h-[52px] bg-bj-primary text-ink rounded-full px-10 sm:px-12 py-3.5 text-[12px] tracking-[0.22em] sm:tracking-[0.24em] uppercase font-bold shadow-[0_8px_22px_rgba(0,0,0,.12)] hover:bg-bj-primary-active hover:-translate-y-0.5 transition-all duration-200 ease-out"
    >See All</a>
  </div>
</section>
