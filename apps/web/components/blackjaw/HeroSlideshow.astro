---
const slides = [
  { src: "/brand/blackjaw_runner.png", heading: "RESTOCK", eyebrow: "BITE THROUGH LIMITS", cta: "SHOP", href: "#featured" },
  { src: "/brand/photo_2026-05-12 16.55.14.jpeg", heading: "NEW DROP", eyebrow: "THE JAWS NEVER BREAK", cta: "SHOP", href: "#featured" },
  { src: "/brand/photo_2026-05-12 16.54.58.jpeg", heading: "RESTOCK", eyebrow: "BACK IN STOCK", cta: "SHOP", href: "#featured" },
];
---
<section class="relative w-full h-[100svh] min-h-[560px] overflow-hidden bg-black" data-blackjaw-hero>
  {slides.map((s, i) => (
    <div class={`blackjaw-slide absolute inset-0 transition-opacity duration-[900ms] ease-in-out ${i === 0 ? "opacity-100" : "opacity-0"}`} data-idx={i}>
      <img src={encodeURI(s.src)} alt={s.heading} class="w-full h-full object-cover object-[center_30%]" />
      <div class="absolute inset-0 bg-gradient-to-b from-black/30 via-transparent to-black/25 pointer-events-none"></div>
      <h1 class="sr-only">{s.heading}</h1>
      <div class="absolute inset-0 flex flex-col items-center justify-center text-center text-white px-5 sm:px-6">
        <span
          class="text-[13px] sm:text-[20px] lg:text-[26px] uppercase tracking-[0.24em] sm:tracking-[0.3em] lg:tracking-[0.34em] font-semibold max-w-[22ch]"
          style="text-shadow:0 1px 8px rgba(0,0,0,.7);"
        >{s.eyebrow}</span>
        <a
          href={s.href}
          class="mt-6 sm:mt-8 inline-flex items-center justify-center min-h-[48px] sm:min-h-[56px] bg-bj-primary text-ink rounded-full px-10 sm:px-14 py-3.5 sm:py-4 text-[12px] sm:text-[14px] tracking-[0.22em] sm:tracking-[0.24em] uppercase font-bold shadow-[0_10px_28px_rgba(0,0,0,.28)] hover:bg-bj-primary-active hover:-translate-y-0.5 transition-all duration-200 ease-out"
        >{s.cta}</a>
      </div>
    </div>
  ))}
  <div class="absolute bottom-7 left-1/2 -translate-x-1/2 z-10 w-12 h-[2px] bg-white/30 rounded-full overflow-hidden">
    {slides.map((_, i) => (
      <span class={`blackjaw-bar absolute inset-y-0 left-0 block w-full bg-white rounded-full transition-opacity duration-500 ease-in-out ${i === 0 ? "opacity-100" : "opacity-0"}`} data-idx={i}></span>
    ))}
  </div>
</section>

<script>
  const root = document.querySelector("[data-blackjaw-hero]");
  if (root) {
    const slides = root.querySelectorAll<HTMLElement>(".blackjaw-slide");
    const bars = root.querySelectorAll<HTMLElement>(".blackjaw-bar");
    let i = 0;
    setInterval(() => {
      slides[i].style.opacity = "0";
      bars[i].style.opacity = "0";
      i = (i + 1) % slides.length;
      slides[i].style.opacity = "1";
      bars[i].style.opacity = "1";
    }, 5000);
  }
</script>
