---
const slides = [
  { src: "/brand/blackjaw_runner.png", mobileSrc: "/brand/photo_2026-05-12 16.55.19.jpeg", heading: "RESTOCK", eyebrow: "BITE THROUGH LIMITS", cta: "SHOP", href: "#featured" },
  { src: "/brand/photo_2026-05-12 16.55.14.jpeg", heading: "NEW DROP", eyebrow: "THE JAWS NEVER BREAK", cta: "SHOP", href: "#featured" },
  { src: "/brand/photo_2026-05-12 16.54.58.jpeg", heading: "RESTOCK", eyebrow: "BACK IN STOCK", cta: "SHOP", href: "#featured" },
];
---
<section
  class="relative w-full h-[100svh] min-h-[560px] overflow-hidden bg-black group/hero"
  data-blackjaw-hero
  aria-roledescription="carousel"
  aria-label="Featured drops"
>
  {slides.map((s, i) => (
    <div
      class={`blackjaw-slide absolute inset-0 ${i === 0 ? "" : "pointer-events-none"}`}
      data-idx={i}
      role="group"
      aria-roledescription="slide"
      aria-label={`${i + 1} of ${slides.length}`}
      aria-hidden={i === 0 ? "false" : "true"}
      style={i === 0 ? "opacity:1;visibility:inherit" : "opacity:0;visibility:hidden"}
    >
      <picture class="block w-full h-full">
        {s.mobileSrc && (
          <source media="(max-width: 639px)" srcset={encodeURI(s.mobileSrc)} />
        )}
        <img src={encodeURI(s.src)} alt={s.heading} class="w-full h-full object-cover object-[center_25%] sm:object-[center_30%]" />
      </picture>
      <div class="absolute inset-0 bg-gradient-to-b from-black/30 via-transparent to-black/25 pointer-events-none"></div>
      <h1 class="sr-only">{s.heading}</h1>
      <div class="absolute inset-0 flex flex-col items-center justify-start lg:justify-center pt-28 sm:pt-32 lg:pt-0 text-center text-white px-5 sm:px-6">
        <span
          class="text-[16px] sm:text-[20px] lg:text-[26px] uppercase tracking-[0.22em] sm:tracking-[0.3em] lg:tracking-[0.34em] font-semibold whitespace-nowrap"
          style="text-shadow:0 1px 8px rgba(0,0,0,.7);"
        >{s.eyebrow}</span>
        <a
          href={s.href}
          class="mt-6 sm:mt-8 inline-flex items-center justify-center min-h-[48px] sm:min-h-[56px] bg-bj-primary text-ink rounded-full px-10 sm:px-14 py-3.5 sm:py-4 text-[14px] sm:text-[14px] tracking-[0.22em] sm:tracking-[0.24em] uppercase font-bold font-[family-name:var(--font-button)] shadow-[0_10px_28px_rgba(0,0,0,.28)] hover:bg-bj-primary-active hover:-translate-y-0.5 transition-all duration-200 ease-out"
        >{s.cta}</a>
      </div>
    </div>
  ))}

  {/* Brand manifesto — statement anchored to the bottom-left. On mobile the
      eyebrow + CTA shift to the upper area so the two zones never collide;
      the long-form supporting line stays desktop-only. */}
  <div
    class="absolute inset-x-0 bottom-0 h-[58%] z-[5] pointer-events-none bg-gradient-to-t from-black/65 via-black/25 to-transparent"
    aria-hidden="true"
  ></div>
  <div
    class="flex absolute bottom-0 left-0 max-w-[36rem] pl-5 sm:pl-6 lg:pl-24 xl:pl-32 pr-6 pb-28 sm:pb-32 lg:pb-16 xl:pb-20 z-10 flex-col pointer-events-none"
    data-blackjaw-slogan
  >
    <span class="blackjaw-slogan-line block h-[3px] w-10 rounded-full bg-bj-primary"></span>
    <p class="blackjaw-slogan-line mt-6 font-[family-name:var(--font-primary)] text-white">
      <span
        class="block text-[20px] sm:text-[24px] xl:text-[30px] font-medium leading-[1.2] tracking-[-0.01em]"
        style="text-shadow:0 2px 18px rgba(0,0,0,.6);"
      >The real battle is not against others.</span>
      <span
        class="mt-1.5 block text-[24px] sm:text-[28px] xl:text-[36px] font-semibold leading-[1.12] tracking-[-0.015em]"
        style="text-shadow:0 2px 18px rgba(0,0,0,.65);"
      >It’s always you vs you.</span>
    </p>
    <p
      class="blackjaw-slogan-line hidden lg:block mt-5 max-w-[30rem] font-[family-name:var(--font-primary)] text-[14px] xl:text-[15px] font-normal leading-[1.65] text-white/85"
      style="text-shadow:0 1px 12px rgba(0,0,0,.7);"
    >Black Jaw stands on your side — not to comfort, to push. To make sure you show up, and follow through.</p>
  </div>

  <button
    type="button"
    data-blackjaw-prev
    aria-label="Previous slide"
    class="absolute left-3 sm:left-5 lg:left-8 top-1/2 -translate-y-1/2 z-20 grid place-items-center w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-black/25 sm:bg-black/20 text-white backdrop-blur-md ring-1 ring-white/15 transition-all duration-200 ease-out hover:bg-black/40 hover:scale-105 active:scale-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-bj-primary sm:opacity-0 sm:group-hover/hero:opacity-100"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
  </button>

  <button
    type="button"
    data-blackjaw-next
    aria-label="Next slide"
    class="absolute right-3 sm:right-5 lg:right-8 top-1/2 -translate-y-1/2 z-20 grid place-items-center w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-black/25 sm:bg-black/20 text-white backdrop-blur-md ring-1 ring-white/15 transition-all duration-200 ease-out hover:bg-black/40 hover:scale-105 active:scale-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-bj-primary sm:opacity-0 sm:group-hover/hero:opacity-100"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
  </button>

  <div
    class="absolute bottom-6 sm:bottom-8 left-1/2 -translate-x-1/2 z-20 flex items-center gap-2 sm:gap-2.5"
    role="tablist"
    aria-label="Slide navigation"
  >
    {slides.map((_, i) => (
      <button
        type="button"
        data-blackjaw-dot
        data-idx={i}
        role="tab"
        aria-label={`Go to slide ${i + 1}`}
        aria-selected={i === 0 ? "true" : "false"}
        class="group/dot relative h-3 flex items-center px-0.5 focus-visible:outline-none"
      >
        <span class={`blackjaw-track block h-[3px] rounded-full overflow-hidden bg-white/30 transition-[width] duration-500 ease-out ${i === 0 ? "w-10 sm:w-12" : "w-5 sm:w-6"}`}>
          <span class="blackjaw-fill block h-full bg-white rounded-full will-change-transform"></span>
        </span>
      </button>
    ))}
  </div>

  <span class="sr-only" aria-live="polite" data-blackjaw-live></span>
</section>

<style>
  /* Staggered fade-up reveal for the left-anchored manifesto. */
  [data-blackjaw-slogan] .blackjaw-slogan-line {
    opacity: 0;
    transform: translateY(20px);
    animation: blackjaw-slogan-reveal 0.85s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  [data-blackjaw-slogan] .blackjaw-slogan-line:nth-child(1) { animation-delay: 0.2s; }
  [data-blackjaw-slogan] .blackjaw-slogan-line:nth-child(2) { animation-delay: 0.32s; }
  [data-blackjaw-slogan] .blackjaw-slogan-line:nth-child(3) { animation-delay: 0.44s; }

  @keyframes blackjaw-slogan-reveal {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-blackjaw-slogan] .blackjaw-slogan-line {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  import gsap from "gsap";

  const root = document.querySelector<HTMLElement>("[data-blackjaw-hero]");
  if (root) {
    const slides = gsap.utils.toArray<HTMLElement>(".blackjaw-slide", root);
    const images = slides.map((s) => s.querySelector<HTMLImageElement>("img")!);
    const dots = gsap.utils.toArray<HTMLButtonElement>("[data-blackjaw-dot]", root);
    const fills = gsap.utils.toArray<HTMLElement>(".blackjaw-fill", root);
    const tracks = gsap.utils.toArray<HTMLElement>(".blackjaw-track", root);
    const prev = root.querySelector<HTMLButtonElement>("[data-blackjaw-prev]");
    const next = root.querySelector<HTMLButtonElement>("[data-blackjaw-next]");
    const live = root.querySelector<HTMLElement>("[data-blackjaw-live]");
    const total = slides.length;
    const DURATION = 5;
    const wActive = ["w-10", "sm:w-12"];
    const wIdle = ["w-5", "sm:w-6"];

    let current = 0;
    let isAnimating = false;
    let progressTween: gsap.core.Tween | null = null;
    let kenBurns: gsap.core.Tween | null = null;
    let autoplayId: ReturnType<typeof setTimeout> | null = null;

    // Initial state — only slide 0 visible
    gsap.set(slides, { autoAlpha: 0 });
    gsap.set(slides[0], { autoAlpha: 1 });
    gsap.set(images, { scale: 1 });
    gsap.set(fills, { scaleX: 0, transformOrigin: "left center" });

    const mm = gsap.matchMedia();
    let reduced = false;
    mm.add(
      { motion: "(prefers-reduced-motion: no-preference)", reduced: "(prefers-reduced-motion: reduce)" },
      (ctx) => {
        reduced = !!ctx.conditions?.reduced;
      }
    );

    const setDotState = (idx: number) => {
      dots.forEach((d, i) => d.setAttribute("aria-selected", i === idx ? "true" : "false"));
      tracks.forEach((t, i) => {
        const active = i === idx;
        wActive.forEach((c) => t.classList.toggle(c, active));
        wIdle.forEach((c) => t.classList.toggle(c, !active));
      });
    };

    const runKenBurns = (idx: number) => {
      kenBurns?.kill();
      if (reduced) return;
      gsap.set(images[idx], { scale: 1 });
      kenBurns = gsap.to(images[idx], {
        scale: 1.08,
        duration: DURATION + 1.4,
        ease: "none",
      });
    };

    const runProgress = (idx: number, onComplete: () => void) => {
      progressTween?.kill();
      gsap.set(fills, { scaleX: (i) => (i < idx ? 1 : 0) });
      if (reduced) {
        gsap.set(fills[idx], { scaleX: 1 });
        return;
      }
      progressTween = gsap.fromTo(
        fills[idx],
        { scaleX: 0 },
        { scaleX: 1, duration: DURATION, ease: "none", onComplete },
      );
    };

    const goTo = (rawIdx: number, dir: 1 | -1 = 1) => {
      const idx = ((rawIdx % total) + total) % total;
      if (idx === current || isAnimating) return;
      isAnimating = true;

      const fromSlide = slides[current];
      const toSlide = slides[idx];

      slides.forEach((s, i) => s.setAttribute("aria-hidden", i === idx ? "false" : "true"));
      setDotState(idx);
      if (live) live.textContent = `Slide ${idx + 1} of ${total}`;

      const tl = gsap.timeline({
        defaults: { ease: "power2.inOut" },
        onComplete: () => {
          fromSlide.classList.add("pointer-events-none");
          toSlide.classList.remove("pointer-events-none");
          current = idx;
          isAnimating = false;
          runKenBurns(idx);
          schedule();
        },
      });

      // Cross-fade with a soft directional drift on the image
      tl.set(toSlide, { autoAlpha: 0, zIndex: 2 })
        .set(fromSlide, { zIndex: 1 })
        .fromTo(
          images[idx],
          { xPercent: 4 * dir, scale: 1.04 },
          { xPercent: 0, scale: 1, duration: 1.1, ease: "power3.out" },
          0,
        )
        .to(toSlide, { autoAlpha: 1, duration: 0.9 }, 0)
        .to(fromSlide, { autoAlpha: 0, duration: 0.9 }, 0)
        .to(
          images[current],
          { scale: 1.06, duration: 1.1, ease: "power2.out" },
          0,
        );

      runProgress(idx, () => goTo(idx + 1, 1));
    };

    const schedule = () => {
      if (autoplayId) clearTimeout(autoplayId);
      // progress tween drives the next advance; this is just a safety net
    };

    const pause = () => {
      progressTween?.pause();
      kenBurns?.pause();
    };
    const resume = () => {
      progressTween?.resume();
      kenBurns?.resume();
    };

    // Kick off slide 0
    setDotState(0);
    runKenBurns(0);
    runProgress(0, () => goTo(1, 1));

    prev?.addEventListener("click", () => goTo(current - 1, -1));
    next?.addEventListener("click", () => goTo(current + 1, 1));
    dots.forEach((d, i) =>
      d.addEventListener("click", () => goTo(i, i > current ? 1 : -1)),
    );

    root.addEventListener("pointerenter", pause);
    root.addEventListener("pointerleave", resume);
    root.addEventListener("focusin", pause);
    root.addEventListener("focusout", resume);

    root.setAttribute("tabindex", "0");
    root.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") { e.preventDefault(); goTo(current - 1, -1); }
      if (e.key === "ArrowRight") { e.preventDefault(); goTo(current + 1, 1); }
    });

    // Swipe
    let startX = 0, startY = 0, tracking = false;
    root.addEventListener("touchstart", (e) => {
      const t = e.touches[0];
      startX = t.clientX; startY = t.clientY; tracking = true;
    }, { passive: true });
    root.addEventListener("touchend", (e) => {
      if (!tracking) return;
      const t = e.changedTouches[0];
      const dx = t.clientX - startX;
      const dy = t.clientY - startY;
      tracking = false;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) {
        const dir: 1 | -1 = dx < 0 ? 1 : -1;
        goTo(current + dir, dir);
      }
    });
  }
</script>
