---
const perks = [
  "EARLY ACCESS",
  "PACK PERKS",
  "ATHLETE JOURNAL",
  "BIRTHDAY GIFT",
];

const columns = [
  { title: "SHOP", links: ["MEN", "WOMEN", "SIGNATURE DROP", "GIFT CARDS", "OUTLET"] },
  { title: "SUPPORT", links: ["SIZE GUIDE", "SHIPPING", "RETURNS", "FABRIC CARE", "CONTACT"] },
  { title: "COMPANY", links: ["OUR STORY", "JOURNAL", "CAREERS", "PRESS", "SUSTAINABILITY"] },
  { title: "LEGAL", links: ["TERMS", "PRIVACY", "GDPR", "COOKIES", "ACCESSIBILITY"] },
];

const socials = ["INSTAGRAM", "TIKTOK", "YOUTUBE", "STRAVA"];
---
<footer class="bg-[#0a0a0a] text-white">
  <div class="max-w-[1440px] mx-auto px-5 sm:px-8 lg:px-14">

    {/* Newsletter */}
    <section class="pt-14 sm:pt-20 lg:pt-24 pb-12 sm:pb-16">
      <div class="text-[10px] tracking-[0.32em] text-white/50 mb-8 sm:mb-12">STAY LOCKED IN</div>

      <div class="grid grid-cols-1 lg:grid-cols-[1.05fr_1fr] gap-10 lg:gap-16 items-start">
        <div>
          <h2 class="font-[family-name:var(--font-primary)] font-extrabold uppercase leading-[0.92] tracking-[-0.02em] text-[14vw] sm:text-[88px] lg:text-[104px]">
            FIRST IN.<br/>FIRST FITTED.
          </h2>
          <p class="mt-6 max-w-md text-[13px] sm:text-sm text-white/60 leading-relaxed">
            48-hour early access to every drop. Athlete journals. Pack perks. No filler — we email 4× a month, max.
          </p>
        </div>

        <div class="lg:pt-3">
          <form action="#" onsubmit="return false" class="flex items-stretch gap-2 sm:gap-3">
            <label class="flex-1 flex items-center bg-white text-ink rounded-sm px-4 sm:px-5 min-h-[52px]">
              <input
                type="email"
                placeholder="your@email.com"
                class="w-full bg-transparent outline-none text-[13px] sm:text-sm placeholder:text-ink/40"
              />
            </label>
            <button class="shrink-0 bg-bj-primary text-ink rounded-sm min-h-[52px] px-5 sm:px-8 text-[11px] sm:text-xs tracking-[0.22em] uppercase font-bold font-[family-name:var(--font-button)] hover:bg-bj-primary-active transition-colors">
              Join →
            </button>
          </form>

          <ul class="mt-7 grid grid-cols-2 gap-x-6 gap-y-3 text-[11px] tracking-[0.22em] text-white/70">
            {perks.map((p) => (
              <li class="flex items-center gap-2">
                <span class="text-white/40">/</span>
                <span>{p}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <div class="h-px bg-white/10"></div>

    {/* Brand + Columns */}
    <section class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-x-6 gap-y-10 py-12 sm:py-16">
      <div class="col-span-2 lg:col-span-2 max-w-xs">
        <div class="flex items-center gap-3 mb-5">
          <img
            src="/brand/blackjaw-mark.png"
            alt=""
            width="28"
            height="28"
            class="w-7 h-7 object-contain invert"
          />
          <img
            src="/brand/Black jaw White.png"
            alt="Black Jaw"
            class="h-4 w-5 select-none"
          />
        </div>
        <div class="text-[10px] tracking-[0.32em] text-white/40 mb-4">EST. 2026</div>
        <p class="text-[13px] text-white/55 leading-relaxed">
          Black Jaw makes one thing: gear that outlasts the athlete wearing it. Quiet, sharp, locked in — for the version of you that shows up anyway.
        </p>
      </div>

      {columns.map((c) => (
        <div>
          <h4 class="text-[10px] tracking-[0.28em] text-white/50 mb-5">{c.title}</h4>
          <ul class="space-y-3.5">
            {c.links.map((l) => (
              <li>
                <a href="#" class="text-[12px] tracking-[0.18em] text-white/85 hover:text-bj-primary transition-colors">
                  / {l}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>

    <div class="h-px bg-white/10"></div>

    {/* Closing line */}
    <section class="pt-12 sm:pt-16 pb-8">
      <div class="flex items-start justify-between gap-6 sm:gap-10">
        <h3 class="min-w-0 font-[family-name:var(--font-primary)] font-extrabold uppercase leading-[0.95] tracking-[-0.02em] text-[7vw] sm:text-[34px] lg:text-[44px]">
          <span class="block text-white">YOU SAID YOU WANTED IT.</span>
          <span class="block text-white/30">SO WHY NOT NOW?</span>
          <span class="block text-white">GO AND GET IT,</span>
          <span class="block text-white/30">BLACK JAW IS HERE WITH YOU.</span>
        </h3>
        <img
          src="/brand/blackjaw-mark.png"
          alt=""
          aria-hidden="true"
          class="shrink-0 w-14 sm:w-20 lg:w-28 h-auto invert"
        />
      </div>
    </section>

    <div class="h-px bg-white/10"></div>

    {/* Utility bar */}
    <section class="py-6 sm:py-7 flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-[10px] tracking-[0.26em] text-white/45 order-3 sm:order-1">
        © 2026 BLACK JAW LTD. · ALL RIGHTS RESERVED
      </p>

      <ul class="flex flex-wrap items-center gap-x-6 gap-y-2 text-[10px] tracking-[0.28em] order-1 sm:order-2">
        {socials.map((s) => (
          <li>
            <a href="#" class="text-white/80 hover:text-bj-primary transition-colors">{s}</a>
          </li>
        ))}
      </ul>

      <div class="flex items-center gap-2 order-2 sm:order-3">
        <a href="#" class="flex items-center justify-center border border-white/25 rounded-sm min-h-[40px] px-4 text-[10px] tracking-[0.24em] uppercase font-[family-name:var(--font-button)] text-white hover:border-bj-primary hover:text-bj-primary transition-colors">
          App Store
        </a>
        <a href="#" class="flex items-center justify-center border border-white/25 rounded-sm min-h-[40px] px-4 text-[10px] tracking-[0.24em] uppercase font-[family-name:var(--font-button)] text-white hover:border-bj-primary hover:text-bj-primary transition-colors">
          Google Play
        </a>
      </div>
    </section>

  </div>
</footer>
