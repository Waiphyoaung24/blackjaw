---
const nav = [
  { text: "PRODUCTS", href: "#" },
  { text: "MEN", href: "#" },
  { text: "WOMEN", href: "#" },
];
---
<header
  data-blackjaw-header
  class="absolute inset-x-0 top-0 z-30 transition-[background-color,color,box-shadow] duration-300 ease-out"
  style="color:#ffffff"
>
  <div class="relative flex items-center justify-between gap-4 sm:gap-8 px-3 sm:px-4 lg:px-8 h-[56px] sm:h-[64px] lg:h-[72px]">
    <button class="lg:hidden w-10 h-10 flex items-center justify-center -ml-2" aria-label="Menu">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
    </button>

    <a
      href="/"
      class="flex items-center shrink-0 absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 lg:static lg:translate-x-0 lg:translate-y-0"
      aria-label="Blackjaw home"
    >
      <img
        data-logo-white
        src={encodeURI("/brand/Black jaw White.png")}
        alt="Blackjaw"
        class="h-[22px] sm:h-6 lg:h-5 w-auto max-w-[200px] sm:max-w-none block drop-shadow-[0_1px_4px_rgba(0,0,0,0.35)]"
      />
      <img
        data-logo-dark
        src={encodeURI("/brand/Blac Jaw Black logo.png")}
        alt=""
        aria-hidden="true"
        class="h-[22px] sm:h-6 lg:h-5 w-auto max-w-[200px] sm:max-w-none hidden"
      />
    </a>

    <nav class="hidden lg:flex absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 items-center gap-7 xl:gap-9">
      {nav.map((n) => (
        <a
          href={n.href}
          class="text-[11.5px] font-[family-name:var(--font-display)] font-bold tracking-[0.18em] uppercase whitespace-nowrap hover:opacity-70 transition-opacity"
        >{n.text}</a>
      ))}
    </nav>

    <div class="flex items-center shrink-0 -mr-1 sm:mr-0">
      <a
        href="#cart"
        aria-label="Cart"
        class="relative w-11 h-11 flex items-center justify-center hover:opacity-70 transition-opacity drop-shadow-[0_1px_3px_rgba(0,0,0,0.4)]"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 7h12l-1.5 12H7.5L6 7z"/><path d="M9 7a3 3 0 1 1 6 0"/></svg>
        <span class="absolute top-1.5 right-1.5 bg-bj-primary text-ink text-[9px] leading-none font-bold rounded-full min-w-[16px] h-[16px] px-1 flex items-center justify-center ring-2 ring-black/10">0</span>
      </a>
    </div>
  </div>
</header>

<style>
  [data-blackjaw-header] { color: #ffffff !important; }
  [data-blackjaw-header] a,
  [data-blackjaw-header] nav a,
  [data-blackjaw-header] button { color: #ffffff !important; }
  [data-blackjaw-header][data-pinned="true"] {
    position: fixed;
    top: 0;
    background-color: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.06);
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-blackjaw-header]");
  const hero = document.querySelector<HTMLElement>("[data-blackjaw-hero]");
  if (header && hero) {
    const apply = () => {
      const past = window.scrollY > hero.offsetHeight - 80;
      header.dataset.pinned = past ? "true" : "false";
      header.classList.toggle("absolute", !past);
    };
    apply();
    window.addEventListener("scroll", apply, { passive: true });
  }
</script>
