---
const nav = [
  { text: "PRODUCTS", href: "#" },
  { text: "MEN", href: "#" },
  { text: "WOMEN", href: "#" },
];
---
<header
  data-blackjaw-header
  class="absolute inset-x-0 top-0 z-30 text-white transition-[background-color,color,box-shadow] duration-300 ease-out"
>
  <div class="relative flex items-center justify-between gap-4 sm:gap-8 px-3 sm:px-4 lg:px-8 h-[56px] sm:h-[64px] lg:h-[72px]">
    <button class="lg:hidden w-10 h-10 flex items-center justify-center -ml-2" aria-label="Menu">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
    </button>

    <a href="/" class="flex items-center shrink-0" aria-label="Blackjaw home">
      <img
        data-logo-white
        src={encodeURI("/brand/Black jaw White.png")}
        alt="Blackjaw"
        class="h-5 lg:h-5 w-auto block"
      />
      <img
        data-logo-dark
        src={encodeURI("/brand/Blac Jaw Black logo.png")}
        alt=""
        aria-hidden="true"
        class="h-5 lg:h-5 w-auto hidden"
      />
    </a>

    <nav class="hidden lg:flex absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 items-center gap-7 xl:gap-9">
      {nav.map((n) => (
        <a
          href={n.href}
          class="text-[11.5px] font-[family-name:var(--font-display)] font-bold tracking-[0.18em] uppercase whitespace-nowrap hover:opacity-70 transition-opacity"
        >{n.text}</a>
      ))}
    </nav>

    <div class="flex items-center shrink-0">
      <a
        href="#cart"
        aria-label="Cart"
        class="relative w-11 h-11 flex items-center justify-center hover:opacity-70 transition-opacity"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 7h12l-1.5 12H7.5L6 7z"/><path d="M9 7a3 3 0 1 1 6 0"/></svg>
        <span class="absolute top-1 right-1 bg-bj-primary text-ink text-[9px] font-bold rounded-full w-[18px] h-[18px] flex items-center justify-center">0</span>
      </a>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-blackjaw-header]");
  const hero = document.querySelector<HTMLElement>("[data-blackjaw-hero]");
  if (header && hero) {
    const overlay = ["absolute", "top-0", "text-white"];
    const pinned = ["fixed", "top-0", "bg-white", "text-ink", "shadow-[0_1px_0_rgba(0,0,0,0.06)]"];
    const logoWhite = header.querySelector<HTMLElement>("[data-logo-white]");
    const logoDark = header.querySelector<HTMLElement>("[data-logo-dark]");
    const onScroll = () => {
      const past = window.scrollY > hero.offsetHeight - 80;
      overlay.forEach((c) => header.classList.toggle(c, !past));
      pinned.forEach((c) => header.classList.toggle(c, past));
      if (logoWhite && logoDark) {
        logoWhite.classList.toggle("hidden", past);
        logoDark.classList.toggle("hidden", !past);
      }
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>
